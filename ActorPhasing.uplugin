	"DocsURL": "https://exordiumgame.com/actor-phasing",
	"MarketplaceURL": "",
	"SupportURL": "https://exordiumgame.com/actor-phasing/support",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Modules": [
		{
			"Name": "ActorPhasing",
			"Type": "Runtime",
			"LoadingPhase": "Default",
